# --- LiveKit (also used for LiveKit Inference — no OpenAI key needed) ---
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Access control (strongly recommended) ---
# Explicit dispatch name. The agent only joins rooms that ask for it.
# Empty = automatic dispatch into EVERY new room in the project.
TMUX_AGENT_NAME=tmux-agent
# Comma-separated identities allowed to talk to the agent, call its RPCs,
# use the HTTP tunnel, and get tokens from token_server.py.
# Empty = anyone in the room.
TMUX_ALLOWED_IDENTITIES=mobile-user

# --- Model (LiveKit Inference realtime model) ---
# TMUX_LLM_MODEL=openai/gpt-realtime

# --- Token server for the iOS app (token_server.py) ---
# TOKEN_SERVER_KEY=change-me-long-random-string
# TOKEN_SERVER_HOST=127.0.0.1
# TOKEN_SERVER_PORT=8787
# TOKEN_TTL_SECONDS=3600

# --- tmux ---
# Session to attach to (created if missing).
TMUX_SESSION_NAME=agent
# Pin the window to COLS x ROWS so another attached client can't resize it.
# TMUX_LOCK_SIZE=1
TMUX_COLS=100
TMUX_ROWS=30
TMUX_FONT_SIZE=20
# TMUX_FONT_PATH=/System/Library/Fonts/Menlo.ttc
TMUX_FPS=10

# --- HTTP tunnel (iOS Browser tab) ---
# TMUX_PROXY_TARGET=http://localhost:3000
# TMUX_PROXY_TIMEOUT=30

# --- Video pipeline ---
# 1 = simple RGBA + minimal publish options (default). 0 = advanced path.
# TMUX_COMPAT_VIDEO=1
# TMUX_COMPAT_WIDTH=1280
# TMUX_COMPAT_HEIGHT=720
# Track source: screenshare (default) or camera.
# TMUX_COMPAT_TRACK_SOURCE=screenshare
# Advanced path only (TMUX_COMPAT_VIDEO=0):
# TMUX_OUT_WIDTH=1280
# TMUX_OUT_HEIGHT=720
# TMUX_VIDEO_CODEC=h264        # vp8 | h264 | h265 | vp9 | av1
# TMUX_TRACK_SOURCE=screenshare
# TMUX_SCREENCAST=0
# TMUX_MAX_BITRATE=8000000

# --- Diagnostics ---
# Stream res/static_share.png instead of the live terminal (default off).
# TMUX_STREAM_STATIC_PNG=1
# TMUX_STATIC_IMAGE=/absolute/or/relative/path/to/screenshot.png
